# Copy this file to .env and fill in your values:  cp config.example.env .env

# Google Places API (New) key - optional but gives far better results
# (websites, phone numbers, ratings, review counts).
# https://console.cloud.google.com/ -> enable "Places API (New)" -> Credentials
GOOGLE_PLACES_API_KEY=

# Fetch up to 5 Google reviews per place to detect pain points and activity.
# More accurate leads, but billed at a higher Places API tier. true/false
GOOGLE_FETCH_REVIEWS=true

# Query phrasings tried until enough results are found ({c}=category, {l}=location)
GOOGLE_QUERY_VARIANTS="{c} in {l}|best {c} in {l}|{c} near {l}|local {c} {l}"

# Websites checked in parallel
CHECK_CONCURRENCY=8

# Drop leads scoring below this (0 = keep all)
MIN_SCORE=0

# Delete result folders older than this many days after each search (0 = keep forever)
LEADS_RETENTION_DAYS=30

# Which sources to use (comma separated): google, osm
LEAD_SOURCES=google,osm

# Identify yourself to OpenStreetMap (their usage policy asks for contact info)
USER_AGENT="LeadFinder/1.0 (your-email@example.com)"

# Max HTTP retries on rate limits / server errors
HTTP_MAX_RETRIES=4

# Web app (server.py) login - use a long random password
APP_USER=admin
APP_PASSWORD=

# Country code for phone numbers without one, when the location is not recognised (e.g. 94 = Sri Lanka)
DEFAULT_COUNTRY_CODE=94
